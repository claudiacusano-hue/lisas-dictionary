{
  "name": "lisas-lexicon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "import:lisas": "tsx scripts/import-lisas.ts",
    "import:vocabulary": "tsx scripts/import-vocabulary.ts",
    "check:edge": "deno check --config supabase/functions/submit-proposal/deno.json supabase/functions/submit-proposal/index.ts",
    "format": "prettier --write src scripts tests *.ts *.json docs README.md .github/workflows supabase/functions"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.16",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "deno": "2.9.6",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
